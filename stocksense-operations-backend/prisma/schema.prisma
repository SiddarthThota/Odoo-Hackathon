generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum OperationType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

model DocumentCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Receipt {
  id            String          @id @default(uuid()) @db.Uuid
  referenceNo   String          @unique
  supplierRef   String
  warehouseId   String
  status        OperationStatus @default(DRAFT)
  scheduledDate DateTime
  validatedAt   DateTime?
  createdBy     String
  validatedBy   String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lines ReceiptLine[]

  @@index([status])
  @@index([warehouseId])
  @@index([scheduledDate])
  @@index([createdAt])
}

model ReceiptLine {
  id            String   @id @default(uuid()) @db.Uuid
  receiptId     String   @db.Uuid
  productId     String
  expectedQty   Decimal  @db.Decimal(15, 3)
  receivedQty   Decimal? @db.Decimal(15, 3)
  unitOfMeasure String

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([productId])
}

model Delivery {
  id            String          @id @default(uuid()) @db.Uuid
  referenceNo   String          @unique
  customerRef   String
  warehouseId   String
  status        OperationStatus @default(DRAFT)
  scheduledDate DateTime
  pickedAt      DateTime?
  packedAt      DateTime?
  validatedAt   DateTime?
  createdBy     String
  validatedBy   String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lines DeliveryLine[]

  @@index([status])
  @@index([warehouseId])
  @@index([scheduledDate])
  @@index([createdAt])
}

model DeliveryLine {
  id            String   @id @default(uuid()) @db.Uuid
  deliveryId    String   @db.Uuid
  productId     String
  expectedQty   Decimal  @db.Decimal(15, 3)
  deliveredQty  Decimal? @db.Decimal(15, 3)
  unitOfMeasure String
  pickedAt      DateTime?
  packedAt      DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([productId])
}

model Transfer {
  id                    String          @id @default(uuid()) @db.Uuid
  referenceNo           String          @unique
  sourceLocationId      String
  destinationLocationId String
  status                OperationStatus @default(DRAFT)
  createdBy             String
  validatedBy           String?
  validatedAt           DateTime?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  lines TransferLine[]

  @@index([status])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([createdAt])
}

model TransferLine {
  id         String  @id @default(uuid()) @db.Uuid
  transferId String  @db.Uuid
  productId  String
  quantity   Decimal @db.Decimal(15, 3)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model Adjustment {
  id          String          @id @default(uuid()) @db.Uuid
  productId   String
  locationId  String
  recordedQty Decimal         @db.Decimal(15, 3)
  countedQty  Decimal         @db.Decimal(15, 3)
  delta       Decimal         @db.Decimal(15, 3)
  reason      String?
  status      OperationStatus @default(DRAFT)
  createdBy   String
  appliedBy   String?
  appliedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
}

model MoveHistory {
  id             String        @id @default(uuid()) @db.Uuid
  operationType  OperationType
  operationId    String        @db.Uuid
  productId      String
  quantityDelta  Decimal       @db.Decimal(15, 3)
  fromLocationId String?
  toLocationId   String?
  performedBy    String
  occurredAt     DateTime      @default(now())

  @@index([operationType, operationId])
  @@index([productId])
  @@index([occurredAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@unique([operationType, operationId, productId])
}
