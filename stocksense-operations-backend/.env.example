# PostgreSQL / Prisma 7
DATABASE_URL="postgres://postgres:postgres@localhost:5432/stocksense_operations"

# Runtime JWT verification. Use the same secret as the shared Auth Service in real deployments.
JWT_SECRET="dev-only-change-this-secret"

# Operations -> Inventory Service integration
# mock lets you run the Operations workflows locally without a separate Inventory Service.
INVENTORY_SERVICE_URL="http://localhost:4000"
INVENTORY_SERVICE_MODE="mock"
INVENTORY_SERVICE_TIMEOUT_MS="5000"

# Application
PORT="3001"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Development only. Set false in real deployments.
AUTH_DEV_BYPASS="true"
