{
  "name": "stocksense-operations-backend",
  "version": "1.0.0",
  "private": true,
  "description": "StockSense Operations Management Service - Receipts, Deliveries, Transfers, Adjustments, Move History and operation statistics.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --config ./test/jest-unit.config.js --runInBand",
    "verify:static": "node scripts/verify-contracts.mjs",
    "verify": "npm run typecheck && npm run test:unit && npm run verify:static && npm run safety-check",
    "db:migrate": "prisma migrate dev --name init_operations",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "npm run db:deploy && node scripts/ensure-db-safety.cjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "token:dev": "node scripts/generate-dev-token.cjs",
    "safety-check": "node scripts/safety-check.mjs",
    "test:db-safety": "node scripts/db-safety-test.cjs"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
